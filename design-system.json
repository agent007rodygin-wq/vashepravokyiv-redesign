{
  "name": "Ваше Право — Apple-Inspired Modern Legal Design System",
  "version": "2.0.0",
  "philosophy": {
    "principles": [
      "Clarity over clutter: кожен блок має чітку мету без візуального шуму.",
      "Content & Credibility first: фокус на досвіді 20+ років, гарантіях, авторитеті керівника Олександри Родигіної.",
      "Apple Aesthetic translated for Legal: спокійний глибокий преміальний синій/індиго, чистий parchment-фон (#F5F5F7), вивірена типографіка з від'ємним трекінгом у великих заголовках, pill-кнопки та акуратні картки з тонким hairline-бордером."
    ]
  },
  "colors": {
    "primary": "#0D2B45",
    "primaryHover": "#163E63",
    "accentAction": "#0066CC",
    "accentActionHover": "#0071E3",
    "backgroundMain": "#FFFFFF",
    "backgroundSubtle": "#F5F5F7",
    "backgroundDark": "#151C24",
    "surfaceCard": "#FFFFFF",
    "surfacePearl": "#FAFAFC",
    "textInk": "#1D1D1F",
    "textSecondary": "#6E6E73",
    "textMuted": "#86868B",
    "textOnDark": "#F5F5F7",
    "borderHairline": "#E5E5EA",
    "borderSubtle": "#D2D2D7",
    "statusSuccess": "#34C759",
    "statusWarning": "#FF9500",
    "statusError": "#FF3B30"
  },
  "typography": {
    "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', sans-serif",
    "scale": {
      "displayHero": {
        "fontSize": "48px",
        "lineHeight": "1.1",
        "fontWeight": "700",
        "letterSpacing": "-0.025em",
        "mobile": {
          "fontSize": "32px",
          "lineHeight": "1.2"
        }
      },
      "h1": {
        "fontSize": "36px",
        "lineHeight": "1.2",
        "fontWeight": "700",
        "letterSpacing": "-0.02em",
        "mobile": {
          "fontSize": "28px",
          "lineHeight": "1.25"
        }
      },
      "h2": {
        "fontSize": "28px",
        "lineHeight": "1.25",
        "fontWeight": "600",
        "letterSpacing": "-0.015em",
        "mobile": {
          "fontSize": "22px",
          "lineHeight": "1.3"
        }
      },
      "h3": {
        "fontSize": "20px",
        "lineHeight": "1.35",
        "fontWeight": "600",
        "letterSpacing": "-0.01em",
        "mobile": {
          "fontSize": "18px",
          "lineHeight": "1.35"
        }
      },
      "lead": {
        "fontSize": "19px",
        "lineHeight": "1.5",
        "fontWeight": "400",
        "color": "#6E6E73"
      },
      "body": {
        "fontSize": "16px",
        "lineHeight": "1.55",
        "fontWeight": "400",
        "color": "#1D1D1F"
      },
      "caption": {
        "fontSize": "14px",
        "lineHeight": "1.4",
        "fontWeight": "500",
        "color": "#86868B"
      },
      "micro": {
        "fontSize": "12px",
        "lineHeight": "1.3",
        "fontWeight": "400",
        "color": "#86868B"
      }
    }
  },
  "spacing": {
    "scale": [
      4,
      8,
      12,
      16,
      24,
      32,
      48,
      64,
      80,
      96
    ],
    "sectionDesktop": "80px",
    "sectionMobile": "48px",
    "cardPadding": "32px",
    "gridGap": "24px"
  },
  "components": {
    "header": {
      "height": "64px",
      "background": "rgba(255, 255, 255, 0.92)",
      "backdropFilter": "blur(12px)",
      "borderBottom": "1px solid #E5E5EA",
      "ctaButton": "Pill Accent #0066CC"
    },
    "buttonPrimary": {
      "background": "#0066CC",
      "color": "#FFFFFF",
      "borderRadius": "9999px",
      "padding": "12px 24px",
      "fontWeight": "600",
      "fontSize": "15px",
      "hover": {
        "background": "#0071E3"
      }
    },
    "buttonSecondary": {
      "background": "#F5F5F7",
      "color": "#1D1D1F",
      "borderRadius": "9999px",
      "padding": "12px 24px",
      "fontWeight": "500",
      "fontSize": "15px",
      "hover": {
        "background": "#E5E5EA"
      }
    },
    "cardService": {
      "background": "#FFFFFF",
      "borderRadius": "16px",
      "border": "1px solid #E5E5EA",
      "padding": "32px",
      "shadow": "0 2px 12px rgba(0, 0, 0, 0.04)",
      "hoverShadow": "0 8px 24px rgba(0, 0, 0, 0.08)"
    },
    "badgeTag": {
      "background": "#EBF4FF",
      "color": "#0066CC",
      "borderRadius": "9999px",
      "padding": "4px 12px",
      "fontSize": "12px",
      "fontWeight": "600"
    },
    "inputField": {
      "height": "48px",
      "borderRadius": "10px",
      "border": "1px solid #D2D2D7",
      "padding": "0 16px",
      "fontSize": "15px",
      "focusBorder": "#0066CC"
    },
    "footer": {
      "background": "#151C24",
      "textColor": "#86868B",
      "padding": "64px 0 32px"
    }
  },
  "responsive": {
    "desktop": "1200px max container, 3-column service grid, 80px section spacing",
    "tablet": "768px - 1024px container, 2-column grid, 60px section spacing",
    "mobile": "< 768px, single column, 48px section spacing, full-width touch buttons (min height 48px)"
  }
}